<Project Sdk="Microsoft.NET.Sdk">
  <!-- زیرساخت BNPL. ساختار مثل facilityservice: DBContext، Configuration، Migrations، Seed، Providers (دایادایموند و Sandbox). -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RootNamespace>BnplService.Infrastructure</RootNamespace></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <!-- فقط برای dotnet ef migrations (طراحی) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" PrivateAssets="all" />
    <!-- فقط برای اجرای محلی و تست بدون SQL Server (Bnpl:Database:Provider = Sqlite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BnplService.Contracts/BnplService.Contracts.csproj" />
    <ProjectReference Include="../DayaDiamond.Client/DayaDiamond.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BnplService.Domain.Entity.Common" />
    <Using Include="BnplService.Domain.Entity.Settings" />
    <Using Include="BnplService.Domain.Entity.Requests" />
    <Using Include="BnplService.Domain.Entity.Payments" />
    <Using Include="BnplService.Domain.Enums" />
    <Using Include="BnplService.Domain.Exceptions" />
    <Using Include="BnplService.Domain.Helpers" />
    <Using Include="BnplService.Contracts.Persistence" />
    <Using Include="BnplService.Contracts.Providers" />
    <Using Include="BnplService.Infrastructure.DBContext" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
</Project>
